# =============================================================================
# Frontend Environment Variables Template (Next.js PWA)
# =============================================================================
# Copy file ini ke `.env.local` di folder frontend/, lalu isi credentials.
# JANGAN commit file `.env.local` ke git (sudah di .gitignore).
#
# Variabel dengan prefix NEXT_PUBLIC_ akan ter-expose ke browser (client-side).
# Variabel tanpa prefix hanya accessible di server-side (SSR/SSG).
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API URL
# -----------------------------------------------------------------------------
# Development: http://localhost:8000/api/v1
# Production: https://api.moringsuksok.id/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Firebase Client Config (untuk PWA Push Notification)
# -----------------------------------------------------------------------------
# Dapatkan dari: Firebase Console → Project Settings → General → Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------------------
# VAPID Public Key (untuk Web Push API)
# -----------------------------------------------------------------------------
# Generate di: Firebase Console → Project Settings → Cloud Messaging → Web Configuration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Moring Suksok
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEFAULT_LOCALE=id
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# -----------------------------------------------------------------------------
# PWA Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PWA_THEME_COLOR=#2D6A4F
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#FFFFFF
