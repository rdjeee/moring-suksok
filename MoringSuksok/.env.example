# =============================================================================
# Moring Suksok — Environment Variables Template (ROOT)
# =============================================================================
# Copy file ini ke `.env` di root project, lalu isi credentials Anda.
# JANGAN commit file `.env` ke git (sudah di .gitignore).
#
# Untuk development local, kebanyakan default value sudah cukup.
# Untuk production, ganti semua value dengan credentials yang aman.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (MySQL via Laragon / Docker)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=moring_suksok
MYSQL_USER=moring
MYSQL_PASSWORD=moring123

# Connection URL untuk SQLAlchemy (backend)
# Local Laragon: mysql+pymysql://root:@localhost:3306/moring_suksok
# Docker: mysql+pymysql://root:root@db:3306/moring_suksok
DATABASE_URL=mysql+pymysql://root:@localhost:3306/moring_suksok

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# WAJIB diganti ke string random min 32 chars untuk production!
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-random-min-32-characters-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES_CUSTOMER=10080   # 7 days
ACCESS_TOKEN_EXPIRE_MINUTES_ADMIN=1440         # 1 day

# -----------------------------------------------------------------------------
# Cloudinary (Image Storage untuk upload bukti pembayaran & foto produk)
# -----------------------------------------------------------------------------
# Daftar free di: https://cloudinary.com/users/register/free
# Free tier: 25 credits (1 credit = 1GB storage + 1GB bandwidth)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------------------------
# Firebase Admin (Server-side, untuk kirim push notification ke FCM)
# -----------------------------------------------------------------------------
# 1. Buat project di https://console.firebase.google.com
# 2. Add Web App, dapatkan config (NEXT_PUBLIC_FIREBASE_*)
# 3. Settings → Service Accounts → Generate new private key → download JSON
# 4. Copy values dari JSON ke env vars di bawah
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# -----------------------------------------------------------------------------
# CORS Configuration (Backend)
# -----------------------------------------------------------------------------
# Daftar origin frontend yang diizinkan, dipisahkan koma
CORS_ORIGINS=http://localhost:3000,https://moringsuksok.vercel.app

# -----------------------------------------------------------------------------
# Environment Mode
# -----------------------------------------------------------------------------
NODE_ENV=development
PYTHON_ENV=development

# -----------------------------------------------------------------------------
# Business Settings (Default, bisa diubah via admin dashboard)
# -----------------------------------------------------------------------------
BUSINESS_NAME=Moring Suksok
DEFAULT_SHIPPING_COST=10000
