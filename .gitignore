# =============================================================================
# Moring Suksok — .gitignore (final, GitHub-ready)
# =============================================================================
# Rules:
# - .env files EXCLUDED (contain credentials), .env.example INCLUDED
# - Build artifacts EXCLUDED (node_modules, .next, __pycache__, dll)
# - OS/IDE files EXCLUDED (.DS_Store, .vscode/, dll)
# - download/ & scripts/ EXCLUDED (Agent A artifacts, not part of system)
# =============================================================================

# Z.ai Sandbox Infrastructure (NOT part of Moring Suksok project)
# These files keep the Z.ai cloud sandbox running but should never be
# committed to the GitHub repo (they're environment-specific).
skills/
node_modules/
upload/
.zscripts/
.z-ai-config/
Caddyfile
next-env.d.ts
# Z.ai default demo/reference folders at root (NOT project code)
/examples/
/mini-services/
/tests/
/download/

# Dependencies (frontend + backend)
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.venv/
backend/venv/

# Build outputs
.next/
out/
dist/
build/
*.egg-info/
.eggs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (KEEP .env.example, EXCLUDE actual .env)
.env
.env.local
.env.*.local
backend/.env
!.env.example
!.env.local.example
!backend/.env.example

# Database files (SQLite artifacts - we use MySQL)
*.sqlite
*.sqlite3
*.db
db/

# Test coverage
coverage/
.coverage
htmlcov/
.pytest_cache/

# PWA build artifacts (auto-generated)
public/sw.js
public/workbox-*.js

# Misc
.cache/
temp/
.tmp/

# Agent A artifacts (not needed in repo)
download/
scripts/

# Backup files
*.backup-zai
*.bak
*.orig

# OS-generated files
ehthumbs.db
*.lnk
